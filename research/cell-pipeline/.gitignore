.venv/
__pycache__/
*.pyc

# Raw datasets are large, publicly re-downloadable, and the zips include
# junk macOS resource-fork metadata we don't want in the repo either.
data/**/__MACOSX/
data/**/*.zip
data/**/*.tif
data/**/*.png
data/processed/
results/*.gif

# Demo outputs are regenerated by src/demo.py; shared samples live in handoff/
demo_output/
