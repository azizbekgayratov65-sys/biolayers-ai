# =========================================================
# BioLayers AI — Environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets.
# =========================================================

# ---------------------------------------------------------
# REQUIRED — Supabase (found in Supabase Dashboard →
# Project Settings → API)
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used to encrypt users' Gemini API keys.
# Generate one with: openssl rand -hex 32
# NEVER expose this value to the client.
GEMINI_ENCRYPTION_KEY=

# ---------------------------------------------------------
# OPTIONAL — Supabase trusted server key (server-only).
# Only needed for privileged server-side operations that must
# bypass Row Level Security. Do NOT prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------
# SUPABASE_SECRET_KEY=
# SUPABASE_SECRET_SERVICE_ROLE_KEY=

# ---------------------------------------------------------
# OPTIONAL — OpenAI (used by the Workspace Copilot and graph
# extraction, billed to the application, server-only).
# ---------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_COPILOT_MODEL=

# ---------------------------------------------------------
# OPTIONAL — Groq (used by the evidence-classification engine,
# billed to the application, server-only).
# ---------------------------------------------------------
# GROQ_API_KEY=
# GROQ_EVIDENCE_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------
# OPTIONAL — PubMed / NCBI E-utilities (improves rate limits).
# ---------------------------------------------------------
# NCBI_API_KEY=
# NCBI_EMAIL=
# NCBI_TOOL=biolayers-ai

# ---------------------------------------------------------
# OPTIONAL — Gemini model selection. Defaults to the ranked
# flash list. The old global GEMINI_API_KEY is NOT required:
# each user supplies their own key.
# ---------------------------------------------------------
# GEMINI_MODEL=