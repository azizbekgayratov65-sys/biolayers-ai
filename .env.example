# Supabase (from Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only trusted keys (never exposed to the client)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_SECRET_SERVICE_ROLE_KEY=your-service-role-key

# Server-only encryption key for users' Gemini API keys
GEMINI_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Optional: GCP API keys for future integrations
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY_2=your-backup-gemini-api-key